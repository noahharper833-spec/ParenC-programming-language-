# sourcetimer.par
# Prints the current time and sleeps 1 second.

    TIME                             (++++++++++++++++++++++++++++++++++)
    PRINT                            (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    SLEEP 1000                       (+++++++++++++++++++++++++++++++++++())
    TIME                             (++++++++++++++++++++++++++++++++++)
    PRINT                            (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    HALT                             (+++++++++++++++++++++++++++++++++++++++++++++++++)

