# sourcememory.par
# Demonstrates PUSHPOPSETGET variable memory.

    PUSH 100                         (+(++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++))
    SET 0          # var[0] = 100    (++++++++++++++++++++++(+/))
    PUSH 50                          (+(++++++++++++++++++++++++++++++++++++++++++++++++++))
    SET 1          # var[1] = 50     (++++++++++++++++++++++(+))
    GET 0          # push var[0]     (+++++++++++++++++++++++(+/))
    GET 1          # push var[1]     (+++++++++++++++++++++++(+))
    ADD            # 100  50 = 150   (+++)
    PRINT                            (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    CLEAR 0                          (++++++++++++++++++++++++(+/))
    HALT                             (+++++++++++++++++++++++++++++++++++++++++++++++++)

