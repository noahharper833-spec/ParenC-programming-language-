# sourcegraphics.par
# Draws three small rectangles of different colors.

    # rect 1 at 50,50 size 30x30     
    PUSH 1                           (+(+))
    PUSH 30                          (+(++++++++++++++++++++++++++++++))
    PUSH 30                          (+(++++++++++++++++++++++++++++++))
    PUSH 50                          (+(++++++++++++++++++++++++++++++++++++++++++++++++++))
    PUSH 50                          (+(++++++++++++++++++++++++++++++++++++++++++++++++++))
    RECT                             (++++++++++++++++++++++++++++++++++++++++)
    # rect 2 at 90,50                
    PUSH 2                           (+(++))
    PUSH 30                          (+(++++++++++++++++++++++++++++++))
    PUSH 30                          (+(++++++++++++++++++++++++++++++))
    PUSH 50                          (+(++++++++++++++++++++++++++++++++++++++++++++++++++))
    PUSH 90                          (+(++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++))
    RECT                             (++++++++++++++++++++++++++++++++++++++++)
    # rect 3 at 130,50               
    PUSH 4                           (+(++++))
    PUSH 30                          (+(++++++++++++++++++++++++++++++))
    PUSH 30                          (+(++++++++++++++++++++++++++++++))
    PUSH 50                          (+(++++++++++++++++++++++++++++++++++++++++++++++++++))
    PUSH 130                         (+(++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++))
    RECT                             (++++++++++++++++++++++++++++++++++++++++)
    HALT                             (+++++++++++++++++++++++++++++++++++++++++++++++++)

