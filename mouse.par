# sourcemouse.par
# Reads the mouse and prints X, Y, button state.

    MOUSE       # pushes btn, y, x   (+++++++++++++++++++++++++++++++++++++++++++)
    PRINT       # x                  (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    PRINT       # y                  (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    PRINT       # btn                (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    HALT                             (+++++++++++++++++++++++++++++++++++++++++++++++++)

