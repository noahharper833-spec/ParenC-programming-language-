# sourcecalculator.par
# A tiny calculator: computes 6 * 7 = 42.

    PUSH 6                           (+(++++++))
    PUSH 7                           (+(+++++++))
    MUL        # 6 * 7 = 42          (+++++)
    PRINT                            (++++++++++++++++++++)
    NEWLINE                          (+++++++++++++++++++++)
    HALT                             (+++++++++++++++++++++++++++++++++++++++++++++++++)

